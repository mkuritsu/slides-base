// Cloudflare Worker that serves the public deck (pnpm run deploy).
//
// The Worker only serves static assets. Cloudflare looks assets up by the full
// path of the request, so `pnpm build:deployment` writes the deck under the path of
// the first route below (dist/deployment/talks/my-talk/ here), and dist/deployment/ is the
// assets folder. Change `name` and the route for each talk.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "my-talk-slides",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./dist/deployment",
        // /talks/my-talk redirects to /talks/my-talk/, so the relative asset
        // URLs of the deck resolve.
        "html_handling": "auto-trailing-slash"
    },
    "routes": [
        {
            "pattern": "example.com/talks/my-talk*",
            "zone_name": "example.com"
        }
        // Or serve the deck at the root of its own domain:
        // { "pattern": "talk.example.com", "custom_domain": true }
    ],
    "workers_dev": false,
    "preview_urls": false
}
