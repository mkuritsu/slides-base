{
    "name": "slides-base",
    "version": "1.0.0",
    "private": true,
    "description": "reveal.js slide deck built with Vite, with speaker notes, pacing, PDF export, and a Cloudflare Worker deploy",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "present": "vp build && vp preview --strictPort",
        "pdf": "vp build && node scripts/export-pdf.js",
        "pdf:static": "vp build && node scripts/export-pdf.js --static",
        "pdfs": "vp build && node scripts/export-pdf.js --all",
        "build:deployment": "vp run pdfs && vp build --mode deployment",
        "deploy": "vp run build:deployment && wrangler deploy",
        "timing": "node scripts/check-timing.ts"
    },
    "dependencies": {
        "marked": "4.3.0",
        "reveal.js": "5.2.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "puppeteer": "^25.17.0",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "wrangler": "^4.156.0"
    },
    "engines": {
        "node": ">=26"
    },
    "packageManager": "pnpm@10.28.0"
}
